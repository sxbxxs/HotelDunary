// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  CLEANING
  MAINTENANCE
}

enum ReservationStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

model RoomType {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  capacity    Int
  nightlyRate Int // pesos colombianos, sin decimales
  description String?
  rooms       Room[]
}

model Room {
  id           Int                @id @default(autoincrement())
  number       String             @unique
  floor        Int?
  status       HousekeepingStatus @default(CLEAN)
  active       Boolean            @default(true)
  notes        String?
  roomTypeId   Int
  roomType     RoomType           @relation(fields: [roomTypeId], references: [id])
  reservations Reservation[]
}

model Guest {
  id             Int                @id @default(autoincrement())
  firstName      String
  lastName       String
  documentType   String // CC, CE, PASAPORTE...
  documentNumber String
  nationality    String?
  phone          String?
  email          String?
  notes          String?
  createdAt      DateTime           @default(now())
  reservations   Reservation[]     @relation("MainGuest")
  companionIn    ReservationGuest[]

  @@unique([documentType, documentNumber])
}

model Reservation {
  id         Int                @id @default(autoincrement())
  checkIn    DateTime
  checkOut   DateTime
  status     ReservationStatus  @default(CONFIRMED)
  nightlyRate Int // tarifa congelada al momento de reservar
  adults     Int                @default(1)
  children   Int                @default(0)
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  roomId     Int
  room       Room               @relation(fields: [roomId], references: [id])
  guestId    Int
  guest      Guest              @relation("MainGuest", fields: [guestId], references: [id])
  companions ReservationGuest[]
  payments   Payment[]

  @@index([roomId, checkIn, checkOut])
}

model ReservationGuest {
  reservationId Int
  guestId       Int
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guest         Guest       @relation(fields: [guestId], references: [id])

  @@id([reservationId, guestId])
}

model Payment {
  id            Int           @id @default(autoincrement())
  amount        Int // pesos
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  notes         String?
  reservationId Int
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
}
