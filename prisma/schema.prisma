// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  CLEANING
  MAINTENANCE
}

enum ReservationStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

model RoomType {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  capacity    Int
  nightlyRate Int // pesos colombianos, sin decimales
  description String?
  rooms       Room[]
}

model Room {
  id           Int                @id @default(autoincrement())
  number       String             @unique
  floor        Int?
  status       HousekeepingStatus @default(CLEAN)
  active       Boolean            @default(true)
  notes        String?
  roomTypeId   Int
  roomType     RoomType           @relation(fields: [roomTypeId], references: [id])
  reservations Reservation[]
  roomStocks   RoomStock[]
}

model Guest {
  id             Int                @id @default(autoincrement())
  firstName      String
  lastName       String
  documentType   String // CC, CE, PASAPORTE...
  documentNumber String
  originCity     String?
  nationality    String?
  phone          String?
  email          String?
  notes          String?
  createdAt      DateTime           @default(now())
  reservations   Reservation[]     @relation("MainGuest")
  companionIn    ReservationGuest[]

  @@unique([documentType, documentNumber])
}

model Reservation {
  id         Int                @id @default(autoincrement())
  checkIn    DateTime
  checkOut   DateTime
  status     ReservationStatus  @default(CONFIRMED)
  nightlyRate Int // tarifa congelada al momento de reservar
  adults     Int                @default(1)
  children   Int                @default(0)
  notes      String?
  cancelReason   String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  roomId     Int
  room       Room               @relation(fields: [roomId], references: [id])
  guestId    Int
  guest      Guest              @relation("MainGuest", fields: [guestId], references: [id])
  companions ReservationGuest[]
  payments   Payment[]
  consumptions Consumption[]

  @@index([roomId, checkIn, checkOut])
}

model ReservationGuest {
  reservationId Int
  guestId       Int
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guest         Guest       @relation(fields: [guestId], references: [id])

  @@id([reservationId, guestId])
}

model Payment {
  id            Int           @id @default(autoincrement())
  amount        Int // pesos
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  notes         String?
  reservationId Int
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
}

enum ProductCategory {
  MINIBAR
  EXHIBIDORA_BEBIDAS
  EXHIBIDORA_COMIDA
}

model Product {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  price        Int
  category     ProductCategory
  active       Boolean          @default(true)
  roomStocks   RoomStock[]
  deskStock    FrontDeskStock?
  consumptions Consumption[]
  sales        Sale[]
}

// Cuánto hay de cada producto de minibar en la canasta de cada habitación
model RoomStock {
  roomId    Int
  productId Int
  quantity  Int     @default(0)
  room      Room    @relation(fields: [roomId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@id([roomId, productId])
}

// Cuánto hay de cada producto de las exhibidoras, en recepción
model FrontDeskStock {
  productId Int     @id
  quantity  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])
}

// Lo que un huésped consumió del minibar de su habitación; se suma a su cuenta
model Consumption {
  id            Int         @id @default(autoincrement())
  reservationId Int
  productId     Int
  quantity      Int
  unitPrice     Int // precio congelado al momento del consumo
  consumedAt    DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
}

// Venta directa en recepción (exhibidoras), sin ligarse a ninguna reserva
model Sale {
  id         Int      @id @default(autoincrement())
  productId  Int
  quantity   Int
  unitPrice  Int
  method     PaymentMethod
  soldAt     DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])
}

enum UserRole {
  ADMIN
  RECEPCION
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  role         UserRole @default(RECEPCION)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Expense {
  id          Int      @id @default(autoincrement())
  concept     String
  amount      Int
  spentAt     DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  username  String
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model HotelSettings {
  id            Int      @id @default(1)
  hotelName     String   @default("Mi Hotel")
  nit           String?
  address       String?
  phone         String?
  logoPath      String?
  introVideoPath String?
  primaryColor  String   @default("#0f172a")
  accentColor   String   @default("#0ea5e9")
  updatedAt     DateTime @updatedAt
}

model Shift {
  id            Int       @id @default(autoincrement())
  openedById    Int?
  openedByName  String
  startingCash  Int
  openedAt      DateTime  @default(now())
  closedById    Int?
  closedByName  String?
  countedCash   Int?
  expectedCash  Int?
  difference    Int?
  notes         String?
  closedAt      DateTime?
}